# Imagens originais das cartas (PNG, ~1,7 GB): ficam só na máquina de quem importa coleções.
# O app usa as versões otimizadas de public/cards, geradas por `npm run cards:images` (essas vão no Git).
/cards/

# Ferramentas internas de importação de coleções (scripts de dados, marca d'água, otimização de imagens,
# extensão do slideshare): ficam só na máquina local, fora do repositório.
/scripts/
/tools/

