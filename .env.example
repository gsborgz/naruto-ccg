UPSTASH_REDIS_REST_URL=http://localhost:8078
UPSTASH_REDIS_REST_TOKEN=local_dev_token

# Vercel Blob (artes das cartas criadas), ver docs/DEPLOY.md. Stores novos: BLOB_STORE_ID + VERCEL_OIDC_TOKEN
# (o token vem do `vercel env pull` e expira em ~12 h). Stores antigos: BLOB_READ_WRITE_TOKEN.
# Sem eles, as artes ficam só no navegador de quem criou e não vão para salas nem compartilhamentos.
BLOB_STORE_ID=
VERCEL_OIDC_TOKEN=

# Senha de acesso ao site (pedida uma vez por navegador). Sem ela, o site fica aberto.
SITE_PASSWORD=
