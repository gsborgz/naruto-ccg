UPSTASH_REDIS_REST_URL=http://localhost:8078
UPSTASH_REDIS_REST_TOKEN=local_dev_token

# Vercel Blob (artes das cartas criadas). Copie do store Blob da Vercel (ver docs/DEPLOY.md). Sem ela, as artes
# ficam só no navegador de quem criou e não vão para salas nem compartilhamentos.
BLOB_READ_WRITE_TOKEN=

# Senha de acesso ao site (pedida uma vez por navegador). Sem ela, o site fica aberto.
SITE_PASSWORD=
